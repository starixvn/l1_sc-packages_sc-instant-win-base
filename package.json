{
    "name": "sc-instant-win-base",
    "version": "1.0.0-beta.4",
    "description": "The codebase of instant win games.",
    "main": "src/index.js",
    "scripts": {
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "test-board": "node --es-module-specifier-resolution=node  tests/run.js",
        "reg": "npm set registry https://npm.lumigame.com",
        "pub": "npm publish --registry https://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry https://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/sc-packages/sc-instant-win-base.git"
    },
    "keywords": [
        "game-base",
        "instant-win-game"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "type": "module",
    "license": "ISC",
    "dependencies": {
        "chance": "^1.1.9",
        "lodash": "^4.17.21",
        "sc-game-base": "4.1.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/gitlab": "^6.0.4",
        "@semantic-release/npm": "^7.0.5",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "@types/jest": "^29.5.14",
        "babel-jest": "^29.7.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "^2.0.0",
        "sc-semantic-release": "^1.3.0",
        "semantic-release": "^17.1.1"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
